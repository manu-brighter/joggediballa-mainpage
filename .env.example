# =============================================================================
# Jogge di Balla — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# This file is the single source of truth — keep dev and prod .env aligned with it.

# =============================================================================
# DATABASE
# =============================================================================
# MySQL/MariaDB connection string. Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://joggediballa_user:your_password@localhost:3306/joggediballa

# =============================================================================
# JWT & SESSION SECRETS
# =============================================================================
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET and SESSION_SECRET MUST each be >= 32 chars.
# The server refuses to start otherwise. Use two DIFFERENT secrets.
JWT_SECRET=replace-with-a-32-char-or-longer-random-hex-string
# Signs the OAuth state cookie used during the Google OAuth handshake.
SESSION_SECRET=replace-with-a-DIFFERENT-32-char-random-hex-string

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
# Credentials from https://console.cloud.google.com/apis/credentials
# Setup: see GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an authorized redirect URI configured in Google Cloud Console.
# Production: https://your-domain.tld/api/auth/callback/google
# Development: http://localhost:3000/api/auth/callback/google
GOOGLE_CALLBACK_URL=https://joggediballa.ch/api/auth/callback/google
# Email of the first Google account that should be auto-promoted to admin
# on sign-in. Requires Google to mark the address as `email_verified`.
ADMIN_EMAIL=your-admin-email@gmail.com

# =============================================================================
# SMTP / EMAIL
# =============================================================================
# SMTP host (Gmail: smtp.gmail.com — requires an app password, not your login pw)
SMTP_HOST=smtp.gmail.com
# 587 for STARTTLS, 465 for implicit TLS
SMTP_PORT=587
# Set true ONLY when using port 465 (implicit TLS).
SMTP_SECURE=false
# SMTP authentication
SMTP_USER=joggediballa@gmail.com
SMTP_PASS=
# Default From: header for outbound mail (contact form, notifications).
CONTACT_EMAIL_FROM="Jogge di Balla Website <joggediballa@gmail.com>"
# Recipient for contact-form and Harassenlauf notifications.
CONTACT_EMAIL_TO=joggediballa@gmail.com

# =============================================================================
# FILE UPLOADS (self-hosted disk storage)
# =============================================================================
# Absolute path on the server where uploaded files are written.
# Must exist and be writable by the Node process.
UPLOAD_DIR=/var/www/joggediballa-mainpage/uploads
# Public base URL (no trailing slash) that maps to UPLOAD_DIR via nginx.
PUBLIC_UPLOAD_URL=https://joggediballa.ch/uploads
# Optional. Maximum bytes accepted by /api/upload/* routes (default 15 MB).
# UPLOAD_MAX_BYTES=15728640

# =============================================================================
# APP RUNTIME
# =============================================================================
# Node environment: development | production
NODE_ENV=production
# HTTP port for the Express server.
PORT=3000
# Public base URL of the site, no trailing slash. Used for the sitemap.
BASE_URL=https://joggediballa.ch
# Absolute origin (scheme + host + optional port, no trailing slash) the SPA
# is served from. Used by the CSRF guard to validate the Origin header on
# state-changing API calls. Usually the same value as BASE_URL.
APP_ORIGIN=https://joggediballa.ch
