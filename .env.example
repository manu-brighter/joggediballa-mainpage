# =============================================================================
# Jogge di Balla - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MySQL/MariaDB connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://joggediballa_user:your_password@localhost:3306/joggediballa

# =============================================================================
# JWT & SESSION SECRETS
# =============================================================================
# Generate a secure random string (minimum 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# =============================================================================
# GOOGLE OAUTH CONFIGURATION (for Self-Hosting)
# =============================================================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Setup instructions: See GOOGLE_OAUTH_SETUP.md

# Your Google OAuth Client ID (looks like: 123456789-abc123.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Your Google OAuth Client Secret (looks like: GOCSPX-abc123xyz)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth callback URL (must match Google Cloud Console settings)
# For production: https://your-domain.de/api/auth/callback/google
# For development: http://localhost:3000/api/auth/callback/google
GOOGLE_CALLBACK_URL=https://your-domain.de/api/auth/callback/google

# Admin user email (this Google account will become admin)
ADMIN_EMAIL=your-admin-email@gmail.com

# =============================================================================
# MANUS OAUTH CONFIGURATION (for Manus Platform Hosting)
# =============================================================================
# Only needed if hosting on Manus platform
# Leave empty for self-hosting with Google OAuth

# VITE_APP_ID=your-manus-app-id
# OAUTH_SERVER_URL=https://api.manus.im
# VITE_OAUTH_PORTAL_URL=https://portal.manus.im
# OWNER_OPEN_ID=your-manus-open-id
# OWNER_NAME=Your Name

# =============================================================================
# APP CONFIGURATION
# =============================================================================
# Your website base URL (no trailing slash)
BASE_URL=https://your-domain.de

# App title and logo
VITE_APP_TITLE=Jogge di Balla
VITE_APP_LOGO=/Jogge_Di_Balla_Final_Transparent.png

# Node environment (development or production)
NODE_ENV=production

# Server port (default: 3000)
PORT=3000

# =============================================================================
# OPTIONAL: ANALYTICS
# =============================================================================
# Uncomment if you want to use analytics

# VITE_ANALYTICS_ENDPOINT=https://your-analytics-endpoint.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id

# =============================================================================
# OPTIONAL: BUILT-IN API CONFIGURATION (Manus Platform Only)
# =============================================================================
# Only needed if using Manus built-in services (LLM, storage, etc.)
# Not required for self-hosting

# BUILT_IN_FORGE_API_URL=https://api.manus.im
# BUILT_IN_FORGE_API_KEY=your-api-key
# VITE_FRONTEND_FORGE_API_KEY=your-frontend-api-key
# VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
